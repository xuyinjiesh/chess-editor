{
  "name": "chess-editor-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run gallery:check && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && npm run test:gallery-publish",
    "test:gallery-publish": "node --experimental-strip-types --test scripts/test-gallery-publish.mjs",
    "server": "node server/relay.mjs",
    "gallery:add": "node --experimental-strip-types scripts/gallery.mjs add",
    "gallery:featured": "node --experimental-strip-types scripts/generate-featured-gallery.mjs",
    "gallery:check": "node --experimental-strip-types scripts/gallery.mjs check"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "lucide-react": "^0.468.0",
    "peerjs": "^1.5.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@playwright/test": "^1.49.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  }
}
